# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
NODE_ENV=development
PORT=4000
APP_MODE=DEMO
# APP_MODE controls whether real-money endpoints (Paystack) are reachable.
# Keep this as DEMO until legal/regulatory/payment review is complete (see spec section 15).

CLIENT_ORIGIN=http://localhost:5173

# Logs are JSON lines on stdout (pretty-printed when NODE_ENV=development).
# trace | debug | info | warn | error | fatal | silent. Defaults to info
# (silent under tests).
LOG_LEVEL=info

# --- Error tracking (Sentry) — optional ---
# Leave SENTRY_DSN empty and error tracking is completely off. Operational
# errors (wrong PIN, validation) are never sent, only real bugs plus two
# alert events: payout retries exhausted and reconciliation mismatches.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
# The client's DSN is baked in at build time (client/.env or a Docker
# build arg). Unset means the client bundle contains no Sentry code.
# VITE_SENTRY_DSN=
# Number of reverse-proxy hops (load balancer, CDN, etc.) to trust for
# X-Forwarded-For when determining the real client IP for rate limiting.
# 0 = no proxy in front (correct for local dev and direct deployment).
# If you put a load balancer or CDN in front in production, set this to
# the exact number of hops — an overly permissive value is itself a
# spoofing risk, and 0 behind a real proxy means every user appears to
# share one IP and rate limits stop working per-user.
TRUST_PROXY_HOPS=0

# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/streetboardman?schema=public"
# Least-privilege runtime role for the server/worker (TASK-034). Provision
# it with: psql "$DATABASE_URL" -v app_password="$APP_DB_PASSWORD" -f prisma/roles.sql
# Falls back to DATABASE_URL above when unset, so this is opt-in.
APP_DATABASE_URL="postgresql://streetboardman_app:change-me-app-role-password@localhost:5432/streetboardman?schema=public"

# --- Auth ---
# In production these must each be at least 32 random characters and must
# NOT be left as the values below — the app refuses to start in production
# with a missing, default, or short secret (see server/config/env.js).
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_MFA_CHALLENGE_SECRET=change-me-mfa-challenge-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_MFA_CHALLENGE_TTL=5m

# Staff security gate: from this date, admin tools require MFA and a
# password of 12+ characters. Until then staff only see a warning banner,
# so a future date is a grace period. Unset: enforced immediately when
# NODE_ENV=production, off otherwise.
# STAFF_SECURITY_ENFORCED_FROM=2026-11-01

# SameSite for session cookies: 'lax' (default) works when the client and
# API share a registrable domain (e.g. app.example.com + api.example.com).
# If they're deployed on totally different domains, set this to 'none' —
# the app then forces Secure automatically, since browsers silently drop
# SameSite=None cookies that aren't also Secure (see server/config/env.js).
COOKIE_SAME_SITE=lax

# --- Paystack (only used when APP_MODE=PRODUCTION) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# --- Business defaults (seeded into SystemSetting, editable by Admin afterwards) ---
DEFAULT_BOARDMAN_COMMISSION_RATE=0.05
DEFAULT_PLATFORM_COMMISSION_RATE=0.03
DEFAULT_RESULT_CONFIRMATION_WINDOW_HOURS=2

# --- Seed / demo accounts (used by prisma/seed.js) ---
SEED_ADMIN_PHONE=08000000000
SEED_ADMIN_PASSWORD=Admin@12345
SEED_BOARDMAN_PHONE=08011111111
SEED_BOARDMAN_PASSWORD=Boardman@123
SEED_BETTER_PHONE=08022222222
SEED_BETTER_PASSWORD=Better@12345
